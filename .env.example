# Copie para .env e preencha a chave antes de usar MODO_MOCK=false.
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000

MODO_MOCK=true
MOCK_DIR=app/data/mock

PORTAL_API_BASE_URL=https://api.portaldatransparencia.gov.br/api-de-dados
PORTAL_TRANSPARENCIA_API_KEY=
PORTAL_HTTP_TIMEOUT_SECONDS=10
PORTAL_MAX_RETRIES=1
PORTAL_LIMITE_RPM=150

CACHE_TTL_SECONDS=3600

PERIODO_MIN=2023-03
PERIODO_MAX=2024-12
MAX_MESES_INTERVALO=3

CORS_ORIGINS=http://localhost:5173
